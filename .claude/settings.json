{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/no-commit-on-main.py",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/ruff-on-edit.sh",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Bash(*.env*)",
      "Bash(git -c *)",
      "Bash(git *--receive-pack*)",
      "Bash(git *--upload-pack*)",
      "Bash(git *--exec=*)",
      "mcp__pycharm"
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "autoAllowBashIfSandboxed": false,
    "allowUnsandboxedCommands": false,
    "excludedCommands": [
      "git push *",
      "git push",
      "git fetch *",
      "git pull *"
    ],
    "filesystem": {
      "allowRead": [".env.example"]
    },
    "credentials": {
      "files": [
        {
          "path": ".env",
          "mode": "deny"
        }
      ]
    },
    "network": {
      "allowedDomains": [
        "pypi.org",
        "files.pythonhosted.org",
        "github.com",
        "api.github.com",
        "api.anthropic.com",
        "hn.algolia.com",
        "www.reddit.com",
        "export.arxiv.org",
        "huggingface.co",
        "openai.com",
        "deepmind.google",
        "mistral.ai",
        "www.microsoft.com",
        "techcrunch.com",
        "www.theverge.com",
        "feeds.arstechnica.com",
        "feed.infoq.com"
      ]
    }
  }
}
