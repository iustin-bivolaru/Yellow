# Yellow reads these from the environment. Locally: export them in your shell or use a secret
# manager (e.g. `op run`). In CI: GitHub Secrets. Never put real values in this file.
ANTHROPIC_API_KEY=        # required for the Claude call; without it the keyword-only digest is built
GITHUB_TOKEN=             # optional locally; GitHub Actions provides it (higher API rate limit)
X_BEARER_TOKEN=           # unused: the X source is disabled (paid API)
